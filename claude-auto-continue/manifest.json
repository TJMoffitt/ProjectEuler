{
  "manifest_version": 3,
  "name": "Claude Auto-Continue",
  "version": "1.0.0",
  "description": "Automatically types \"continue\" into the Claude chat box and presses Enter, up to a set number of times.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://claude.ai/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Auto-Continue"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
