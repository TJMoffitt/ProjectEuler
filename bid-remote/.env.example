# Copy to .env and fill in.

# Password for the control page (10+ characters). Make it long: this page can place real bids.
BID_PASSWORD=

# Random string that signs your login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Optional: authenticator-app code on login. Generate a secret with:
#   python -c "import pyotp; print(pyotp.random_base32())"
# then add it to Google Authenticator / 1Password etc. as a manual key.
BID_TOTP_SECRET=

# Optional: refuse to arm any tab with a max bid above this (in £). 0 = no cap.
MAX_BID_CAP=0

# false = a real Chrome window you can see (best on your home PC).
# true  = no window (servers); use View on the control page to see and click the page.
HEADLESS=false

# Where the browser keeps its cookies/logins. Keep it private: it holds your auction logins.
BROWSER_PROFILE=profile

# Optional: use your installed Chrome instead of Playwright's Chromium, e.g.
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   Linux:   /usr/bin/google-chrome
CHROME_PATH=

# Only listen on this machine. Reach it from elsewhere through Tailscale or Cloudflare Tunnel (see README).
HOST=127.0.0.1
PORT=8000

# true once you only reach it over https (tailscale serve / cloudflared both give you https).
COOKIE_SECURE=false
